<%- include('partials/header') %>
<main class="page">
  <div class="wrap split">
    <div>
      <% if (car.image) { %><img class="car-photo" src="<%= car.image %>" alt="<%= car.title %>"><% } %>
    </div>
    <div>
      <div class="eyebrow"><%= car.manufacturer %></div>
      <h1><%= car.title %></h1>
      <p><%= car.model %><% if (car.year) { %> · <%= car.year %><% } %></p>
      <div class="specs">
        <% [
          [t.manufacturer, car.manufacturer],
          [t.model, car.model],
          [t.year, car.year],
          [t.engine, car.engine],
          [t.fuel, car.fuel_type],
          [t.tireSize, car.tire_size],
          [t.tireType, car.tier_type],
          [t.axleLock, car.axle_lock],
          [t.other, car.others]
        ].forEach(function (row) { if (!row[1]) return; %>
          <div><small><%= row[0] %></small><b><%= row[1] %></b></div>
        <% }) %>
      </div>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
