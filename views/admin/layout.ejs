<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Mandraginda</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;600&family=Prompt:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="shell">
    <aside class="side">
      <div class="brand">MANDRAGINDA</div>
      <a href="/admin" class="<%= current === '/admin' ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/homepage" class="<%= current === '/admin/homepage' ? 'active' : '' %>">Homepage</a>
      <a href="/admin/user" class="<%= current === '/admin/user' ? 'active' : '' %>">User</a>
      <a href="/admin/posts" class="<%= current.indexOf('/admin/posts') === 0 ? 'active' : '' %>">Articles</a>
      <a href="/admin/pages" class="<%= current.indexOf('/admin/pages') === 0 ? 'active' : '' %>">Pages</a>
      <a href="/admin/messages" class="<%= current === '/admin/messages' ? 'active' : '' %>">Messages<% if (unread) { %> (<%= unread %>)<% } %></a>
      <a href="/" target="_blank">View site</a>
      <form method="post" action="/admin/logout"><button class="btn quiet" type="submit" style="color:white;margin:10px 12px">Log out</button></form>
    </aside>
    <div class="main">
      <% if (flash) { %><p class="ok"><%= flash %></p><% } %>
      <%- body %>
    </div>
  </div>
</body>
</html>
