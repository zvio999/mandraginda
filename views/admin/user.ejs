<div class="tabs">
  <a class="btn<%= tab === 'users' ? ' gold' : '' %>" href="/admin/user"<% if (tab === 'users') { %> aria-current="page"<% } %>>Users</a>
  <a class="btn<%= tab === 'cars' ? ' gold' : '' %>" href="/admin/user?tab=cars"<% if (tab === 'cars') { %> aria-current="page"<% } %>>Cars</a>
</div>

<% if (tab === 'cars') { %>
  <div class="panel">
    <div class="row">
      <h1>Cars</h1>
      <span><%= cars.length %></span>
    </div>
    <form class="filters" method="get" action="/admin/user">
      <input type="hidden" name="tab" value="cars">
      <label class="wide">User
        <select name="user">
          <option value="">All users</option>
          <% members.forEach(function (member) { %>
            <option value="<%= member.id %>" <%= String(filter.user) === String(member.id) ? 'selected' : '' %>><%= member.display_name || member.username %></option>
          <% }) %>
        </select>
      </label>
      <label>Manufacturer
        <select name="manufacturer" data-makes data-selected="<%= filter.manufacturer %>" data-placeholder="All">
          <option value="">All</option>
        </select>
      </label>
      <label>Model
        <select name="model" data-models data-selected="<%= filter.model %>" data-placeholder="All" <%= filter.manufacturer ? "" : "disabled" %>>
          <option value="">All</option>
        </select>
      </label>
      <%- include('../partials/select', { label: 'Year', name: 'year', options: carOptions.year, selected: filter.year, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Fuel', name: 'fuel_type', options: carOptions.fuel, selected: filter.fuel_type, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Engine', name: 'engine', options: carOptions.engine, selected: filter.engine, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Category', name: 'category', options: carOptions.category, selected: filter.category, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Gearbox', name: 'gearbox', options: carOptions.gearbox, selected: filter.gearbox, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Drive wheels', name: 'drive', options: carOptions.drive, selected: filter.drive, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Number of doors', name: 'doors', options: carOptions.doors, selected: filter.doors, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Winch', name: 'winch', options: carOptions.yesno, selected: filter.winch, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Portal axle', name: 'portal_axle', options: carOptions.yesno, selected: filter.portal_axle, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Axle lock', name: 'axle_lock', options: carOptions.axle, selected: filter.axle_lock, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Tire size', name: 'tire_size', options: carOptions.tireSize, selected: filter.tire_size, choose: 'All', required: false }) %>
      <%- include('../partials/select', { label: 'Tire type', name: 'tier_type', options: carOptions.tireType, selected: filter.tier_type, choose: 'All', required: false }) %>
      <div class="filter-actions">
        <button class="btn" type="submit">Filter</button>
        <% if (filtered) { %><a href="/admin/user?tab=cars">Clear</a><% } %>
      </div>
    </form>
    <script src="/js/garage-car.js"></script>
    <% if (!cars.length) { %>
      <p><%= filtered ? 'No cars match this filter.' : 'No member has added a car yet.' %></p>
    <% } else { %>
      <table>
        <tr><th>Photo</th><th>Car</th><th>Owner</th><th>Details</th><th>Added</th><th></th></tr>
        <% cars.forEach(function (car) { %>
          <tr>
            <td><% if (car.image) { %><img class="thumb" src="<%= car.image %>" alt="<%= car.title %>"><% } %></td>
            <td><b><%= car.title %></b><br><%= [car.manufacturer, car.model, car.year].filter(Boolean).join(' ') %></td>
            <td><%= car.display_name || car.username || 'Deleted member' %><% if (car.email) { %><br><small><%= car.email %></small><% } %></td>
            <td><small><%= detail(car) %></small></td>
            <td><%= car.created_at %></td>
            <td>
              <form method="post" action="/admin/member-cars/<%= car.id %>/delete" onsubmit="return confirm('Delete this car?')">
                <input type="hidden" name="user" value="<%= filter.user %>">
                <% ["manufacturer", "model", "year", "fuel_type", "engine", "category", "gearbox", "drive", "doors", "winch", "portal_axle", "axle_lock", "tire_size", "tier_type"].forEach(function (key) { %>
                  <input type="hidden" name="<%= key %>" value="<%= filter[key] %>">
                <% }) %>
                <button class="btn quiet" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  </div>
<% } else { %>
  <div class="panel">
    <div class="row">
      <h1>Users</h1>
      <span><%= members.length %></span>
    </div>
    <% if (!members.length) { %>
      <p>No registered users were found.</p>
    <% } else { %>
      <table>
        <tr><th>Name</th><th>Username</th><th>Email</th><th>Cars</th></tr>
        <% members.forEach(function (member) { %>
          <tr>
            <td><%= member.display_name || member.username %></td>
            <td><%= member.username %></td>
            <td><%= member.email %></td>
            <td><a href="/admin/user?tab=cars&user=<%= member.id %>"><%= member.car_count %></a></td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  </div>
<% } %>
