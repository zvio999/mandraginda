<%- include('partials/header') %>
<main class="page">
  <div class="wrap">
    <div class="eyebrow"><%= t.account %></div>
    <h1><%= t.registration %></h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form class="form" method="post" action="/register">
      <label><%= t.fullName %><input name="name" value="<%= name %>" required></label>
      <label><%= t.username %><input name="username" value="<%= username %>" required></label>
      <label><%= t.email %><input type="email" name="email" value="<%= email %>" required></label>
      <label><%= t.password %><input type="password" name="password" required minlength="8"></label>
      <button class="btn" type="submit"><%= t.createAccount %></button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
