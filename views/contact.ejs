<%- include('partials/header') %>
<main class="page">
  <div class="wrap">
    <div class="eyebrow"><%= t.contactEyebrow %></div>
    <h1><%= t.sendMessage %></h1>
    <p><%= t.contactLead %></p>
    <% if (sent) { %><p class="note"><%= t.sent %></p><% } %>
    <form class="form" method="post" action="/contact">
      <label><%= t.fullName %><input name="name" required></label>
      <label><%= t.email %><input name="email" type="email" required></label>
      <label><%= t.phone %><input name="phone"></label>
      <label><%= t.message %><textarea name="body" required></textarea></label>
      <input name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
      <button class="btn" type="submit"><%= t.send %></button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
