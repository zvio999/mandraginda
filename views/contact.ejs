<%- include('partials/header') %>
<main class="page">
  <div class="wrap">
    <div class="eyebrow">Contact</div>
    <h1>Send a message</h1>
    <p>Our team is ready to organize an off-road tour for you upon private request.</p>
    <% if (sent) { %><p class="note">Message received. We will get back to you.</p><% } %>
    <form class="form" method="post" action="/contact">
      <label>Name<input name="name" required></label>
      <label>Email<input name="email" type="email" required></label>
      <label>Phone<input name="phone"></label>
      <label>Message<textarea name="body" required></textarea></label>
      <input name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
      <button class="btn" type="submit">Send</button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
