<%- include('partials/header') %>
<main class="page">
  <div class="wrap">
    <div class="eyebrow"><%= t.account %></div>
    <h1><%= t.login %></h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form class="form" method="post" action="/login">
      <label><%= t.usernameOrEmail %><input name="username" required></label>
      <label><%= t.password %><input type="password" name="password" required></label>
      <button class="btn" type="submit"><%= t.login %></button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
