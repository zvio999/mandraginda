<%- include('partials/header') %>
<main class="page">
  <div class="wrap">
    <div class="eyebrow"><%= t.garage %></div>
    <h1><%= car.id ? t.editCar : t.addCar %></h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form class="form" method="post" action="<%= car.id ? '/garage/cars/' + car.id : '/garage/cars' %>" enctype="multipart/form-data">
      <label><%= t.carName %><input name="title" value="<%= car.title || '' %>" maxlength="120" required placeholder="Jeep Wrangler Rubicon"></label>
      <div class="form-row">
        <label><%= t.manufacturer %>
          <select name="manufacturer" data-makes data-selected="<%= car.manufacturer || '' %>" data-placeholder="<%= t.choose %>" required>
            <option value=""><%= t.choose %></option>
          </select>
        </label>
        <label><%= t.model %>
          <select name="model" data-models data-selected="<%= car.model || '' %>" data-placeholder="<%= t.choose %>" <%= car.manufacturer ? "" : "disabled" %> required>
            <option value=""><%= t.choose %></option>
          </select>
        </label>
      </div>
      <div class="form-row">
        <%- include('partials/select', { label: t.year, name: 'year', options: carOptions.year, selected: car.year || '', choose: t.choose, required: false }) %>
        <%- include('partials/select', { label: t.fuel, name: 'fuel_type', options: carOptions.fuel, selected: car.fuel_type || '', choose: t.choose, required: false }) %>
      </div>
      <div class="form-row">
        <%- include('partials/select', { label: t.engine, name: 'engine', options: carOptions.engine, selected: car.engine || '', choose: t.choose, required: false }) %>
        <%- include('partials/select', { label: t.category, name: 'category', options: carOptions.category, selected: car.category || '', choose: t.choose, required: false }) %>
      </div>
      <div class="form-row">
        <%- include('partials/select', { label: t.gearbox, name: 'gearbox', options: carOptions.gearbox, selected: car.gearbox || '', choose: t.choose, required: false }) %>
        <%- include('partials/select', { label: t.driveWheels, name: 'drive', options: carOptions.drive, selected: car.drive || '', choose: t.choose, required: false }) %>
      </div>
      <div class="form-row">
        <%- include('partials/select', { label: t.doors, name: 'doors', options: carOptions.doors, selected: car.doors || '', choose: t.choose, required: false }) %>
        <%- include('partials/select', { label: t.winch, name: 'winch', options: carOptions.yesno, selected: car.winch || '', choose: t.choose, required: false }) %>
      </div>
      <div class="form-row">
        <%- include('partials/select', { label: t.portalAxle, name: 'portal_axle', options: carOptions.yesno, selected: car.portal_axle || '', choose: t.choose, required: false }) %>
        <%- include('partials/select', { label: t.axleLock, name: 'axle_lock', options: carOptions.axle, selected: car.axle_lock || '', choose: t.choose, required: false }) %>
      </div>
      <div class="form-row">
        <%- include('partials/select', { label: t.tireSize, name: 'tire_size', options: carOptions.tireSize, selected: car.tire_size || '', choose: t.choose, required: false }) %>
        <%- include('partials/select', { label: t.tireType, name: 'tier_type', options: carOptions.tireType, selected: car.tier_type || '', choose: t.choose, required: false }) %>
      </div>
      <label><%= t.otherEquipment %><input name="others" value="<%= car.others || '' %>" maxlength="200"></label>
      <label><%= t.photo %><input type="file" name="image" accept="image/*"></label>
      <% if (car.image) { %><img class="garage-thumb" src="<%= car.image %>" alt="<%= car.title %>"><% } %>
      <div class="garage-actions">
        <button class="btn" type="submit"><%= t.save %></button>
        <a class="btn quiet" href="/garage"><%= t.cancel %></a>
      </div>
    </form>
  </div>
</main>
<script src="/js/garage-car.js"></script>
<%- include('partials/footer') %>
