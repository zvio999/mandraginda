<%- include('partials/header') %>
<main class="page">
  <div class="wrap">
    <div class="eyebrow"><%= t.garage %></div>
    <h1><%= t.garage %></h1>

    <section class="garage-cars" aria-labelledby="my-cars">
      <div class="garage-head">
        <h2 id="my-cars"><%= t.myCars %> <small>(<%= cars.length %>)</small></h2>
        <% if (cars.length < limit) { %><a class="btn dark" href="/garage/new"><%= t.addCar %></a><% } %>
      </div>
      <% if (!cars.length) { %>
        <p class="garage-empty"><%= t.noCars %></p>
      <% } else { %>
        <div class="car-grid">
          <% cars.forEach(function (car) { %>
            <article class="car-card">
              <% if (car.image) { %><img src="<%= car.image %>" alt="<%= car.title %>"><% } else { %><div class="car-photo"></div><% } %>
              <div>
                <h3><%= car.title %></h3>
                <p><%= [car.manufacturer, car.model, car.year].filter(Boolean).join(' ') %></p>
                <dl class="specs">
                  <% [['category', t.category, 'category'], ['year', t.year], ['fuel_type', t.fuel, 'fuel'], ['engine', t.engine, 'engine'], ['gearbox', t.gearbox, 'gearbox'], ['drive', t.driveWheels, 'drive'], ['doors', t.doors, 'doors'], ['winch', t.winch, 'yesno'], ['portal_axle', t.portalAxle, 'yesno'], ['axle_lock', t.axleLock, 'axle'], ['tire_size', t.tireSize, 'tireSize'], ['tier_type', t.tireType, 'tireType'], ['others', t.other]].forEach(function (spec) { if (car[spec[0]]) { %>
                    <div><small><%= spec[1] %></small><b><%= spec[2] ? optionLabel(spec[2], car[spec[0]], lang) : car[spec[0]] %></b></div>
                  <% } }) %>
                </dl>
                <div class="garage-actions">
                  <a class="btn" href="/garage/cars/<%= car.id %>"><%= t.edit %></a>
                  <form method="post" action="/garage/cars/<%= car.id %>/delete" onsubmit="return confirm('<%= t.deleteConfirm %>')">
                    <button class="btn quiet" type="submit"><%= t.delete %></button>
                  </form>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
