<%- include('partials/header') %>
<main class="page">
  <div class="wrap">
    <div class="eyebrow"><%= t.newsEyebrow %></div>
    <h1><%= t.newsTitle %></h1>
    <div class="news-grid">
      <% posts.forEach(function (post) { %>
        <article class="news-card">
          <% if (post.image) { %><a href="/<%= post.slug %>"><img src="<%= post.image %>" alt=""></a><% } %>
          <div>
            <time><%= post.published_at %></time>
            <h3><a href="/<%= post.slug %>"><%= post.title %></a></h3>
            <p><%= post.excerpt %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
