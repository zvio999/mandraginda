<%- include('partials/header') %>
<main class="page">
  <div class="wrap prose">
    <time><%= post.published_at %></time>
    <h1><%= post.title %></h1>
    <% if (post.image) { %><img src="<%= post.image %>" alt=""><% } %>
    <div><%- post.body %></div>
  </div>
</main>
<%- include('partials/footer') %>
